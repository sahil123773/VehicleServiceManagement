@model VehicleServiceManagement.Models.ServiceRecord

<h2>Add Service Record</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="VehicleId" class="form-label">
            Vehicle
        </label>

        <select asp-for="VehicleId"
                asp-items="ViewBag.Vehicles"
                class="form-control">

            <option value="0">-- Select Vehicle --</option>
        </select>
        <span asp-validation-for="VehicleId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceType" class="form-label">
            Service Type
        </label>

        <input asp-for="ServiceType"
               class="form-control"
               placeholder="Enter service type" />

        <span asp-validation-for="ServiceType"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">
            Description
        </label>

        <textarea asp-for="Description"
                  maxlength=""
                  class="form-control"
                  placeholder="Enter service description">
        </textarea>
        <span asp-validation-for="Description"
              class="text-danger"></span>
       
    </div>

    <div class="mb-3">
        <label asp-for="Cost" class="form-label">
            Cost
        </label>

        <input asp-for="Cost"
               type="number"
               step="0.01"
               class="form-control"
               placeholder="Enter service cost" />

        <span asp-validation-for="Cost"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceDate" class="form-label">
            Service Date
        </label>

        <input asp-for="ServiceDate"
               type="date"
               class="form-control" />
        <span asp-validation-for="ServiceDate"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Add Service
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

<script>
    document.getElementById("Description").addEventListener("input", function () {

        var message = document.querySelector(
            '[data-valmsg-for="Description"]'
        );

        if (this.value.length > 500) {
            message.textContent = "Description cannot exceed 500 characters";
        }
        else {
            message.textContent = "";
        }
    });
</script>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}